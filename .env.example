# Application
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
WORKER_HEALTH_PORT=3001
CORS_ORIGIN=http://localhost:5173

# MySQL (Prisma)
DATABASE_URL=mysql://scheduler:scheduler_dev@localhost:3308/job_scheduler

# Docker Compose MySQL bootstrap (used by the mysql service)
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=job_scheduler
MYSQL_USER=scheduler
MYSQL_PASSWORD=scheduler_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — required even before auth is implemented so the process fails fast
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Worker
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=1000
SHUTDOWN_GRACE_MS=30000
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000
WORKER_RECOVERY_INTERVAL_MS=15000
JOB_DEFAULT_TIMEOUT_MS=30000
WORKER_VERSION=0.1.0

# Retention
JOB_LOG_RETENTION_DAYS=30
HEARTBEAT_RETENTION_DAYS=7

# Docker Compose (optional overrides)
# SEED_ON_START=false
# MYSQL_HOST_PORT=3308
# API_HOST_PORT=3000
# WORKER_HOST_PORT=3001
# WEB_HOST_PORT=5173
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
